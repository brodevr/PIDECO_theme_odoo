<odoo>
    <template id="pideco_layout_19" inherit_id="website.layout" name="PIDECO site shell" priority="90">
        <xpath expr="//header" position="replace">
            <header id="top" class="pideco-header">
                <!-- Announcement bar: a ribbon that scrolls continuously. pideco_ui.js repeats the group of messages
                     (copies hidden from screen readers) until it covers the bar, and stops it in the website editor. -->
                <div class="pideco-announcement" data-pideco-promo-marquee="">
                    <div class="pideco-promo-track">
                        <div class="pideco-promo-group">
                            <!-- While a message still holds its original text, the copy below is shown instead, so it is translated like any other template text. Once edited in Settings, the field takes over. -->
                            <span t-if="website.pideco_promo_text_1 == 'Nationwide shipping'" class="pideco-promo-item">Nationwide shipping</span>
                            <span t-else="" class="pideco-promo-item" t-field="website.pideco_promo_text_1"/>
                            <span t-if="website.pideco_promo_text_2 == 'Minimum purchase $200,000'" class="pideco-promo-item">Minimum purchase $200,000</span>
                            <span t-else="" class="pideco-promo-item" t-field="website.pideco_promo_text_2"/>
                            <span t-if="website.pideco_promo_text_3 == 'Store pickup available'" class="pideco-promo-item">Store pickup available</span>
                            <span t-else="" class="pideco-promo-item" t-field="website.pideco_promo_text_3"/>
                        </div>
                    </div>
                </div>
                <div class="container-fluid pideco-header-main">
                    <button class="pideco-mobile-menu" type="button" data-pideco-menu-open="" aria-controls="pidecoNav" aria-expanded="false" aria-label="Open menu"><i class="fa fa-bars" t-translation="off"/></button>
                    <ul class="top_menu d-none"><li class="o_no_autohide_item"/></ul>
                    <nav id="pidecoNav" class="pideco-nav d-lg-flex">
                        <div class="pideco-nav-mobile-head"><img src="/pideco_theme/static/src/assets/pideco-logo.png" alt="PIDECO"/><button type="button" data-pideco-menu-close="" aria-label="Close menu"><i class="fa fa-times" t-translation="off"/></button></div>
                        <form class="pideco-nav-search" action="/shop" method="get" role="search">
                            <input type="search" name="search" placeholder="Search products…" aria-label="Search"/>
                            <button type="submit" aria-label="Search"><i class="fa fa-search" t-translation="off"/></button>
                        </form>
                        <a href="/shop?order=create_date+desc">New arrivals</a>
                        <a href="/shop">Shop</a>
                        <t t-set="pideco_menu_categories" t-value="request.env['product.public.category'].search([('parent_id', '=', False), ('has_published_products', 'in', [True])] + list(website.website_domain()), order='sequence, id', limit=6)"/>
                        <div class="pideco-mega" data-pideco-mega="" t-if="pideco_menu_categories">
                            <button type="button" class="pideco-mega-toggle" data-pideco-mega-toggle="" aria-expanded="false">Categories <i class="fa fa-angle-down" t-translation="off"/></button>
                            <div class="pideco-mega-panel">
                                <div class="pideco-mega-inner">
                                    <div class="pideco-mega-title"><span>Categories</span></div>
                                    <div class="pideco-mega-groups">
                                        <section t-foreach="pideco_menu_categories" t-as="menu_category">
                                            <a class="pideco-mega-heading" t-att-href="'/shop/category/%s' % slug(menu_category)" t-out="menu_category.name"/>
                                            <a t-foreach="menu_category.child_id.filtered_domain([('has_published_products', 'in', [True])] + list(website.website_domain()))[:6]" t-as="menu_child" t-att-href="'/shop/category/%s' % slug(menu_child)" t-out="menu_child.name"/>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pideco-mobile-category-view" data-pideco-mobile-category-view="" aria-hidden="true" t-if="pideco_menu_categories">
                            <button type="button" class="pideco-mobile-category-back" data-pideco-mobile-category-back=""><i class="fa fa-arrow-left" t-translation="off"/> <span>Back to menu</span></button>
                            <h2>Categories</h2>
                            <!-- One row per category; those with subcategories open as an accordion (native <details>, no JS). -->
                            <div class="pideco-mobile-category-groups">
                                <t t-foreach="pideco_menu_categories" t-as="mobile_category">
                                    <t t-set="mobile_children" t-value="mobile_category.child_id.filtered_domain([('has_published_products', 'in', [True])] + list(website.website_domain()))"/>
                                    <details t-if="mobile_children" class="pideco-mobile-category">
                                        <summary><span t-out="mobile_category.name"/><i class="fa fa-angle-down" t-translation="off"/></summary>
                                        <div class="pideco-mobile-category-links">
                                            <a class="pideco-mobile-category-all" t-att-href="'/shop/category/%s' % slug(mobile_category)">View all</a>
                                            <a t-foreach="mobile_children" t-as="mobile_child" t-att-href="'/shop/category/%s' % slug(mobile_child)" t-out="mobile_child.name"/>
                                        </div>
                                    </details>
                                    <a t-else="" class="pideco-mobile-category pideco-mobile-category-link" t-att-href="'/shop/category/%s' % slug(mobile_category)"><span t-out="mobile_category.name"/><i class="fa fa-angle-right" t-translation="off"/></a>
                                </t>
                            </div>
                        </div>
                        <a href="/#historia">About us</a>
                        <div class="pideco-nav-account">
                            <a href="/shop/wishlist"><i class="fa fa-heart-o" t-translation="off"/><span>Wishlist</span></a>
                            <a href="/my"><i class="fa fa-user-o" t-translation="off"/><span>My account</span></a>
                            <a t-if="not request.env.user._is_public()" href="/web/session/logout?redirect=/"><i class="fa fa-sign-out" t-translation="off"/><span>Log out</span></a>
                        </div>
                    </nav>
                    <div class="pideco-nav-backdrop" data-pideco-menu-close="" aria-hidden="true"/>
                    <a class="pideco-brand" href="/" aria-label="PIDECO home"><img src="/pideco_theme/static/src/assets/pideco-logo.png" alt="PIDECO"/></a>
                    <div class="pideco-actions">
                        <button type="button" data-pideco-search-open="" aria-label="Search" title="Search"><i class="fa fa-search" t-translation="off"/></button>
                        <a class="pideco-account-link" t-att-href="'/web/login' if request.env.user._is_public() else '/my'" aria-label="My account" title="My account"><i class="fa fa-user-o" t-translation="off"/></a>
                        <!-- o_wsale_my_wish / o_wsale_my_cart / my_*_quantity are the hooks Odoo's wishlist and cart JS update. -->
                        <t t-set="pideco_wishcount" t-value="len(request.env['product.wishlist'].current())"/>
                        <a href="/shop/wishlist" class="o_wsale_my_wish pideco-wish-button" aria-label="Wishlist" title="Wishlist"><i class="fa fa-heart-o" t-translation="off"/><sup t-attf-class="my_wish_quantity #{'d-none' if not pideco_wishcount else ''}" t-out="pideco_wishcount"/></a>
                        <t t-set="pideco_order" t-value="request.cart"/>
                        <ul class="list-unstyled m-0"><li class="pideco-header-cart o_wsale_my_cart"><a href="/shop/cart" class="pideco-cart-button" aria-label="View cart" title="View cart"><i class="fa fa-shopping-bag" t-translation="off"/><sup t-attf-class="my_cart_quantity #{'d-none' if not pideco_order.cart_quantity else ''}" t-out="pideco_order.cart_quantity or 0"/></a></li></ul>
                    </div>
                </div>
            </header>
        </xpath>

        <xpath expr="//header" position="after">
            <div class="pideco-search-overlay" data-pideco-search-overlay="" aria-hidden="true">
                <div class="pideco-search-panel">
                    <div class="pideco-panel-heading"><span>Search products</span><button type="button" data-pideco-search-close="" aria-label="Close search"><i class="fa fa-times"/></button></div>
                    <form method="get" class="pideco-overlay-form" action="/shop"><div class="pideco-overlay-input"><i class="fa fa-search"/><input type="search" name="search" placeholder="Search products…" autocomplete="off"/><button class="btn btn-primary" type="submit">Search</button></div></form>
                    <div class="pideco-search-hints"><span>Suggestions</span><a href="/shop?search=Canastos">Baskets</a><a href="/shop?search=Frascos">Jars</a><a href="/shop?search=Cubiertos">Cutlery</a><a href="/shop?search=Alfombras">Rugs</a></div>
                </div>
            </div>
        </xpath>

        <xpath expr="//footer" position="attributes">
            <attribute name="class" add="pideco-footer" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='footer']/section[1]" position="replace">
            <section class="pideco-footer pideco-footer-content" data-name="PIDECO footer">
                <!-- Links without a destination yet (href="#"): set them in the website editor. -->
                <div class="container pideco-footer-grid">
                    <div class="pideco-footer-intro"><img src="/pideco_theme/static/src/assets/pideco-logo.png" alt="PIDECO"/><p>Warmth in every corner</p><p>Perón 2560 · pideco.com.ar</p></div>
                    <div><h3>Help</h3><a href="#">Frequently asked questions</a><a href="#">Exchanges and returns</a><a href="#">WhatsApp [NUMBER]</a></div>
                    <div><h3>Legal</h3><a href="#">Consumer protection</a><a href="#">Cancellation button</a><a href="#">Terms and conditions</a></div>
                    <div><h3>Follow us</h3><a href="#">Instagram @pideco_bazar</a><a href="#">Facebook</a></div>
                </div>
                <div class="container pideco-footer-bottom">
                    <span>© 2026 Pídeco. All rights reserved.</span>
                    <nav class="pideco-language-selector" aria-label="Language">
                        <t t-set="pideco_lang_es" t-value="website.language_ids.filtered_domain([('code', '=', 'es_AR')])[:1]"/>
                        <t t-set="pideco_lang_zh" t-value="website.language_ids.filtered_domain([('code', '=', 'zh_CN')])[:1]"/>
                        <t t-set="pideco_lang_en" t-value="website.language_ids.filtered_domain([('code', '=like', 'en_%')])[:1]"/>
                        <i class="fa fa-globe" t-translation="off"/>
                        <span>Language</span>
                        <a t-if="pideco_lang_es" t-att-href="'/website/lang/%s?r=/' % pideco_lang_es.url_code" t-att-data-pideco-language="pideco_lang_es.url_code" t-att-class="'is-active' if request.env.lang == 'es_AR' else ''" lang="es">ES</a>
                        <a t-if="pideco_lang_en" t-att-href="'/website/lang/%s?r=/' % pideco_lang_en.url_code" t-att-data-pideco-language="pideco_lang_en.url_code" t-att-class="'is-active' if request.env.lang == pideco_lang_en.code else ''" lang="en">EN</a>
                        <a t-if="pideco_lang_zh" t-att-href="'/website/lang/%s?r=/' % pideco_lang_zh.url_code" t-att-data-pideco-language="pideco_lang_zh.url_code" t-att-class="'is-active' if request.env.lang == 'zh_CN' else ''" lang="zh-CN">ZH</a>
                    </nav>
                </div>
            </section>
        </xpath>
    </template>

    <template id="pideco_homepage_19" inherit_id="website.homepage" name="PIDECO homepage" priority="90">
        <xpath expr="//div[@id='wrap']" position="replace">
            <!-- The home alternates editable zones (oe_structure with an id: the website editor can add, remove,
                 reorder and edit their blocks, and saves each zone on its own) with automatic sections that are
                 rendered from the catalog on every visit and therefore are not part of any zone. -->
            <!-- Editable zones must not hold QWeb directives (t-*): Odoo would treat them as dynamic and not let
                 the editor change them. The "PIDECO news" list id is therefore rendered here, outside the zones,
                 and pideco_ui.js passes it to the newsletter form and to the popup form. -->
            <t t-set="pideco_news_list" t-value="request.env.ref('pideco_theme.mailing_list_pideco_news', raise_if_not_found=False)"/>
            <div id="wrap" class="pideco-home oe_website_sale" t-att-data-pideco-news-list="pideco_news_list.id if pideco_news_list else None">
                <t t-set="pideco_sale_domain" t-value="list(website.sale_product_domain()) + [('is_published', '=', True)]"/>
                <!-- Zone 1: hero carousel (native Odoo s_carousel markup, so the editor can add slides and change backgrounds, links and speed). -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_1">
                <section class="s_carousel_wrapper p-0 pideco-hero-carousel" data-snippet="s_carousel" data-name="Banner principal PIDECO" data-vxml="001" data-vcss="001">
                    <div id="pidecoHeroCarousel" class="s_carousel s_carousel_default carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
                        <div class="carousel-inner">
                            <div class="carousel-item active oe_img_bg o_bg_img_center" style="background-image: url('/pideco_theme/static/src/img/home/hero-1.jpg');" data-name="Slide">
                                <div class="o_we_bg_filter bg-black-50"/>
                                <div class="container oe_unremovable">
                                    <div class="row">
                                        <div class="carousel-content pideco-banner-content col-lg-7"><p class="pideco-kicker">Homeware and decor for everyday living</p><h1>Transform your home<br/>into your favorite place.</h1><p>Functional objects, natural textures and simple design for every space.</p><p><a class="btn btn-light stretched-link" href="/shop">Shop now</a></p></div>
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item oe_img_bg o_bg_img_center" style="background-image: url('/pideco_theme/static/src/img/home/hero-2.jpg');" data-name="Slide">
                                <div class="o_we_bg_filter bg-black-50"/>
                                <div class="container oe_unremovable">
                                    <div class="row">
                                        <div class="carousel-content pideco-banner-content col-lg-7"><p class="pideco-kicker">Noble, lasting pieces</p><h2>Usefulness and<br/>pared-back beauty.</h2><p>Homeware and decor selected to celebrate calm, order and the small moments at home.</p><p><a class="btn btn-light stretched-link" href="/shop?order=create_date+desc">New arrivals</a></p></div>
                                    </div>
                                </div>
                            </div>
                            <div class="carousel-item oe_img_bg o_bg_img_center" style="background-image: url('/pideco_theme/static/src/img/home/hero-3.jpg');" data-name="Slide">
                                <div class="o_we_bg_filter bg-black-50"/>
                                <div class="container oe_unremovable">
                                    <div class="row">
                                        <div class="carousel-content pideco-banner-content col-lg-7"><p class="pideco-kicker">Purchasing for your business</p><h2>Wholesale benefits</h2><p>Volume discounts and personal service for retailers and projects.</p><p><a class="btn btn-light stretched-link" href="/contactus">I want to buy wholesale</a></p></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev o_not_editable" contenteditable="false" data-bs-target="#pidecoHeroCarousel" data-bs-slide="prev" aria-label="Previous" title="Previous"><span class="carousel-control-prev-icon" aria-hidden="true"/></button>
                        <button class="carousel-control-next o_not_editable" contenteditable="false" data-bs-target="#pidecoHeroCarousel" data-bs-slide="next" aria-label="Next" title="Next"><span class="carousel-control-next-icon" aria-hidden="true"/></button>
                        <div class="carousel-indicators o_not_editable">
                            <button type="button" data-bs-target="#pidecoHeroCarousel" data-bs-slide-to="0" class="active" aria-label="Carousel indicator"/>
                            <button type="button" data-bs-target="#pidecoHeroCarousel" data-bs-slide-to="1" aria-label="Carousel indicator"/>
                            <button type="button" data-bs-target="#pidecoHeroCarousel" data-bs-slide-to="2" aria-label="Carousel indicator"/>
                        </div>
                    </div>
                </section>

                </div>

                <!-- Zone "categories": "Discover our products", six category cards. They are ordinary editable blocks (Bootstrap
                     columns): the editor changes each photo, name and link, and adds or removes cards. The link is the
                     name (edited like any text link); a stretched link makes the whole card clickable outside the editor. -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_categories">
                <section class="pideco-home-section pideco-categories-grid" data-name="Conocé nuestros productos">
                    <div class="container">
                        <div class="pideco-centered-head">
                            <h2>Discover our products</h2>
                            <p>Choose by room and find what you need for your kitchen, your table and every corner of your home.</p>
                        </div>
                        <div class="row pideco-cat-row">
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-cocina.jpg" alt="Kitchen" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">Kitchen</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-mesa-vajilla.jpg" alt="Table and tableware" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">Table and tableware</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-bar-cafe.jpg" alt="Bar, coffee and drinks" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">Bar, coffee and drinks</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-organizacion.jpg" alt="Organization and storage" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">Organization and storage</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-hogar-bano.jpg" alt="Home and bath" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">Home and bath</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                            <div class="col-6 col-lg-4"><div class="pideco-cat-card"><img src="/pideco_theme/static/src/img/home/cat-nuevo.jpg" alt="New" loading="lazy"/><p class="pideco-cat-name"><a class="stretched-link" href="#">New</a><i class="fa fa-long-arrow-right"></i></p></div></div>
                        </div>
                    </div>
                </section>
                </div>

                <!-- New arrivals: the products marked "Featured on the home page", in the shop order; while none is
                     marked, the latest published products. Four cards, no slider. -->
                <section class="container pideco-home-section pideco-arrivals" data-name="Recién llegados">
                    <div class="pideco-arrivals-head"><h2>Just arrived</h2><a href="/shop?order=create_date+desc">View all</a></div>
                    <t t-set="pideco_products" t-value="request.env['product.template'].search(pideco_sale_domain + [('pideco_featured', '=', True)], order='website_sequence, id desc', limit=4)"/>
                    <t t-if="not pideco_products" t-set="pideco_products" t-value="request.env['product.template'].search(pideco_sale_domain, order='id desc', limit=4)"/>
                    <div class="pideco-arrivals-grid">
                        <t t-foreach="pideco_products" t-as="product"><t t-call="pideco_theme.pideco_slider_product_card"/></t>
                        <div class="pideco-products-empty" t-if="not pideco_products"><h3>The collection is on its way</h3><p>Publish products in Odoo to display them here.</p><a href="/shop" class="btn btn-primary">Go to the shop</a></div>
                    </div>
                </section>

                <!-- Zone "brand": the brand, step by step, and the store opening. id="historia" is the target of the
                     "About us" menu link. Buttons without a destination yet (href="#"): set them in the editor. -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_brand">
                <section id="historia" class="pideco-brandstory" data-name="La marca, paso a paso">
                    <div class="container pideco-brandstory-grid">
                        <div class="pideco-brandstory-copy">
                            <p class="pideco-kicker">The brand, step by step</p>
                            <h2>We believe in the beauty of everyday life.</h2>
                            <p>In the objects that accompany our rituals, in materials that convey warmth and in the small details that turn a house into a home.</p>
                            <a class="btn btn-primary" href="#">See how Pídeco came together</a>
                        </div>
                        <div class="pideco-brandstory-swatches">
                            <div class="pideco-swatch pideco-swatch-wine"><strong>Burgundy</strong><span>#4E0E14</span></div>
                            <div class="pideco-swatch pideco-swatch-cream"><strong>Cream</strong><span>#ECD8CC</span></div>
                            <div class="pideco-swatch pideco-swatch-type"><span class="pideco-swatch-aa">Aa</span><strong>Typography</strong></div>
                        </div>
                    </div>
                </section>
                <section class="pideco-opening" data-name="Estamos por abrir">
                    <div class="pideco-opening-media"><img src="/pideco_theme/static/src/img/home/local-peron.jpg" alt="The Pídeco store at Perón 2560" loading="lazy"/></div>
                    <div class="pideco-opening-copy">
                        <h2>We are about to open our doors</h2>
                        <p class="pideco-opening-address">Perón 2560</p>
                        <p class="pideco-opening-hours">[OPENING DATE]: [OPENING HOURS]</p>
                        <a class="btn btn-light" href="#">Let me know when it opens</a>
                    </div>
                </section>
                </div>

                <!-- Zone 4: wholesale benefits and discounts by order amount. -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_4">
                <section class="pideco-wholesale" data-name="Beneficios mayoristas">
                    <div class="container pideco-wholesale-grid">
                        <div><p class="pideco-kicker">Purchasing for your business</p><h2>Wholesale benefits</h2><p>Get volume discounts, personal service and offers tailored to retailers, projects and large orders.</p><a class="btn btn-light" href="/contactus">I want to buy wholesale</a></div>
                        <div class="pideco-wholesale-benefits"><div><i class="fa fa-tags"/><strong>Volume discounts</strong><span>Better terms based on your order.</span></div><div><i class="fa fa-user"/><strong>Personal service</strong><span>We help you choose every product.</span></div><div><i class="fa fa-cubes"/><strong>Project orders</strong><span>Solutions for retailers and interior projects.</span></div></div>
                    </div>
                </section>

                <section class="container pideco-home-section pideco-discounts" data-name="Descuentos por monto">
                    <div class="pideco-section-head"><div><p class="pideco-kicker">The more you buy, the more you save</p><h2>Discounts by order amount</h2><p>Choose the payment method that works best for your order.</p></div></div>
                    <div class="pideco-discount-grid">
                        <div class="pideco-discount-card"><h3>Cash payment</h3><div><span>Purchasing $200,000</span><strong>5% Off</strong></div><div><span>Purchasing $400,000</span><strong>10% Off</strong></div><div><span>Purchasing $700,000</span><strong>15% Off</strong></div><div><span>Purchasing $1,000,000</span><strong>20% Off</strong></div></div>
                        <div class="pideco-discount-card"><h3>Bank transfer</h3><div><span>Purchasing $300,000</span><strong>5% Off</strong></div><div><span>Purchasing $600,000</span><strong>10% Off</strong></div><div><span>Purchasing $1,000,000</span><strong>15% Off</strong></div><div><span>Purchasing $1,500,000</span><strong>20% Off</strong></div></div>
                    </div>
                    <p class="pideco-discount-note">* Discounts are subject to change and do not apply to sale items.</p>
                </section>
                </div>

                <!-- Zone "newsletter": "Be the first to know". Odoo's newsletter form (Email Marketing): each address joins the
                     "PIDECO news" mailing list. The editor can switch the list from the form's options. -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_newsletter">
                <section class="pideco-newsletter" data-name="Enterate primero de todo">
                    <div class="container pideco-newsletter-inner">
                        <h2>Be the first to know</h2>
                        <p>Pídeco news and offers, straight to your inbox.</p>
                        <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe pideco-newsletter-form" data-vxml="001" data-list-id="0" data-name="Newsletter Form" data-snippet="s_newsletter_subscribe_form">
                            <div class="js_subscribed_wrap d-none">
                                <p class="pideco-newsletter-thanks"><i class="fa fa-check-circle-o" role="img"></i> Thanks for subscribing!</p>
                            </div>
                            <div class="js_subscribe_wrap">
                                <label class="pideco-newsletter-label" for="pidecoNewsletterEmail">Your email</label>
                                <div class="pideco-newsletter-row">
                                    <input id="pidecoNewsletterEmail" type="email" name="email" class="s_newsletter_subscribe_form_input js_subscribe_value form-control" placeholder="name@mail.com" autocomplete="email"/>
                                    <a role="button" href="#" class="js_subscribe_btn o_submit btn btn-primary">Subscribe</a>
                                </div>
                            </div>
                        </div>
                        <p class="pideco-newsletter-note">[WELCOME BENEFIT: confirm whether there will be one]</p>
                    </div>
                </section>
                </div>

                <!-- Zone "popup": "Join the Pídeco home", only on the home, 3 seconds after loading. Odoo's native popup
                     (once closed it stays hidden for 7 days) with Odoo's native form: each entry creates a contact,
                     with name and email, in the "PIDECO news" mailing list. Everything is editable in the website
                     editor (the popup is listed among the page's invisible elements). -->
                <div class="oe_structure oe_empty" id="oe_structure_pideco_home_popup">
                <div class="s_popup o_snippet_invisible pideco-popup" id="pidecoNewsPopup" data-vcss="001" data-snippet="s_popup" data-name="Popup Sumate a la casa Pídeco" data-invisible="1">
                    <div class="modal fade s_popup_middle" style="background-color: rgba(40, 14, 16, .55) !important;" data-show-after="3000" data-display="afterDelay" data-consents-duration="7" data-bs-focus="false" data-bs-backdrop="false" tabindex="-1" role="dialog" aria-label="Join the Pídeco home">
                        <div class="modal-dialog d-flex">
                            <div class="modal-content oe_structure">
                                <div class="s_popup_close js_close_popup o_we_no_overlay o_not_editable" aria-label="Close">&#215;</div>
                                <section class="pideco-popup-body" data-name="Suscripción">
                                    <div class="pideco-popup-media"><img src="/pideco_theme/static/src/img/home/popup-bolsa.jpg" alt="Pídeco tote bag" loading="lazy"/></div>
                                    <div class="pideco-popup-copy">
                                        <p class="pideco-popup-kicker">News</p>
                                        <h2>Join the Pídeco home</h2>
                                        <p class="pideco-popup-lead">Be the first to hear about news, new products and the opening of our store at Perón 2560.</p>
                                        <div class="s_website_form pideco-popup-form" data-vcss="001" data-snippet="s_website_form" data-name="Form">
                                            <form action="/website/form/" method="post" enctype="multipart/form-data" data-model_name="mailing.contact" data-success-mode="message" data-pre-fill="true">
                                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char">
                                                        <label class="s_website_form_label" for="pidecoPopupName"><span class="s_website_form_label_content">Name</span></label>
                                                        <input class="form-control s_website_form_input" type="text" name="name" required="1" data-fill-with="name" id="pidecoPopupName" placeholder="What's your name" autocomplete="name"/>
                                                    </div>
                                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="email">
                                                        <label class="s_website_form_label" for="pidecoPopupEmail"><span class="s_website_form_label_content">Email</span></label>
                                                        <input class="form-control s_website_form_input" type="email" name="email" required="1" data-fill-with="email" id="pidecoPopupEmail" placeholder="youremail@example.com" autocomplete="email"/>
                                                    </div>
                                                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_dnone">
                                                        <input type="hidden" class="form-control s_website_form_input" name="list_ids" value=""/>
                                                    </div>
                                                    <div class="mb-0 col-12 s_website_form_submit s_website_form_no_submit_label" data-name="Submit Button">
                                                        <span id="s_website_form_result"/>
                                                        <a href="#" role="button" class="btn btn-primary s_website_form_send">I want to subscribe</a>
                                                    </div>
                                                </div>
                                            </form>
                                            <div class="s_website_form_end_message d-none">
                                                <p class="pideco-popup-thanks">Thanks for joining! We will write to you soon.</p>
                                            </div>
                                        </div>
                                        <ul class="pideco-popup-perks"><li>News first</li><li>Ideas for your home</li><li>No spam</li></ul>
                                        <a href="#" class="pideco-popup-dismiss js_close_popup">No, thanks</a>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="pideco_product_page_19" inherit_id="website_sale.product" name="PIDECO product page" priority="90">
        <xpath expr="//section[@id='product_detail']" position="after">
            <t t-set="pideco_sale_domain" t-value="list(website.sale_product_domain()) + [('is_published', '=', True)]"/>
            <t t-set="pideco_recommendation_domain" t-value="pideco_sale_domain + [('id', '!=', product.id)] + ([('public_categ_ids', 'in', product.public_categ_ids.ids)] if product.public_categ_ids else [])"/>
            <t t-set="pideco_primary_recommendations" t-value="product.alternative_product_ids.filtered_domain(pideco_sale_domain) | request.env['product.template'].search(pideco_recommendation_domain, order='website_sequence, id desc', limit=4)"/>
            <t t-set="pideco_fallback_domain" t-value="pideco_sale_domain + [('id', 'not in', [product.id] + pideco_primary_recommendations.ids)]"/>
            <t t-set="pideco_recommended_products" t-value="(pideco_primary_recommendations | request.env['product.template'].search(pideco_fallback_domain, order='website_sequence, id desc', limit=4))[:4]"/>
            <section class="container pideco-product-recommendations" t-if="pideco_recommended_products">
                <div class="pideco-section-head">
                    <div>
                        <p class="pideco-kicker">Complete your space</p>
                        <h2>You may also like</h2>
                        <p>Products to pair with this selection.</p>
                    </div>
                    <a href="/shop">View all <i class="fa fa-arrow-right"/></a>
                </div>
                <div class="pideco-product-grid pideco-product-grid-short">
                    <a class="pideco-product-card" t-foreach="pideco_recommended_products" t-as="recommended" t-att-href="recommended.website_url">
                        <div class="pideco-product-image">
                            <div class="pideco-product-badges"><span t-if="recommended.compare_list_price and recommended.compare_list_price &gt; recommended.list_price">Offer</span><span t-elif="recommended.create_date">New</span></div>
                            <img t-att-src="'/web/image/product.template/%s/image_512' % recommended.id" t-att-alt="recommended.name"/>
                        </div>
                        <small t-out="recommended.public_categ_ids[:1].name or 'PIDECO'"/>
                        <h3 t-out="recommended.name"/>
                        <strong t-out="recommended.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="pideco-product-link">View product <i class="fa fa-arrow-right"/></span>
                    </a>
                </div>
            </section>
            <section class="container pideco-product-discounts" data-name="Descuentos por monto">
                <div class="pideco-section-head"><div><p class="pideco-kicker">Save on larger orders</p><h2>Discounts</h2><p>Choose the payment method that works best for your order.</p></div></div>
                <div class="pideco-discount-grid">
                    <div class="pideco-discount-card"><h3>Cash payment</h3><div><span>Purchasing $200,000</span><strong>5% Off</strong></div><div><span>Purchasing $400,000</span><strong>10% Off</strong></div><div><span>Purchasing $700,000</span><strong>15% Off</strong></div><div><span>Purchasing $1,000,000</span><strong>20% Off</strong></div></div>
                    <div class="pideco-discount-card"><h3>Bank transfer</h3><div><span>Purchasing $300,000</span><strong>5% Off</strong></div><div><span>Purchasing $600,000</span><strong>10% Off</strong></div><div><span>Purchasing $1,000,000</span><strong>15% Off</strong></div><div><span>Purchasing $1,500,000</span><strong>20% Off</strong></div></div>
                </div>
                <p class="pideco-discount-note">* Discounts are subject to change and do not apply to sale items.</p>
            </section>
        </xpath>
    </template>

    <template id="pideco_product_title_19" inherit_id="website_sale.product_title" name="PIDECO product title" priority="90">
        <xpath expr="//h1" position="before">
            <div class="pideco-product-meta">
                <a t-if="product.public_categ_ids" t-att-href="'/shop/category/%s' % slug(product.public_categ_ids[:1])" t-out="product.public_categ_ids[:1].name"/>
                <span t-if="product_variant.default_code">SKU <t t-out="product_variant.default_code"/></span>
            </div>
        </xpath>
    </template>

    <!-- Product tile (shop grid, wishlist and Odoo's product snippets): internal reference above the name.
         A tile for a given variant shows that variant's code; a product with several variants has no
         single code, so nothing is shown for it. -->
    <template id="pideco_products_item_19" inherit_id="website_sale.products_item" name="PIDECO product tile reference" priority="90">
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="before">
            <t t-set="pideco_reference" t-value="(product_variant or product).default_code"/>
            <small t-if="pideco_reference" class="pideco-product-reference" t-out="pideco_reference"/>
        </xpath>
    </template>

    <template id="pideco_product_terms_19" inherit_id="website_sale.product_terms_and_conditions" name="PIDECO product assurances" priority="90">
        <xpath expr="//small" position="replace">
            <div class="pideco-product-assurances">
                <div><i class="fa fa-shopping-bag"/><span><strong>Minimum order $200,000</strong><small>Applies to wholesale orders</small></span></div>
                <div><i class="fa fa-truck"/><span><strong>Nationwide shipping</strong><small>We coordinate the delivery of your order</small></span></div>
                <div><i class="fa fa-map-marker"/><span><strong>Store pickup</strong><small>Available by prior arrangement</small></span></div>
            </div>
            <!-- Trust: returns policy, secure purchase and the legal links required in Argentina. The texts in
                 brackets and the links (href="#") are completed in the website editor. -->
            <div class="pideco-product-trust">
                <div><i class="fa fa-undo"/><strong>Exchanges and returns</strong><small>[RETURNS POLICY: e.g. up to 30 days after your purchase]</small></div>
                <div><i class="fa fa-shield"/><strong>Secure purchase</strong><small>Your data is protected</small></div>
                <p class="pideco-product-legal"><a href="#">Cancellation button</a><a href="#">Consumer protection</a></p>
            </div>
        </xpath>
    </template>
    <template id="pideco_slider_product_card" name="PIDECO slider product card">
        <article class="pideco-product-card" t-att-data-product-template-id="product.id" t-att-data-product-id="product._get_first_possible_variant_id()" t-att-data-is-combo="'true' if product.type == 'combo' else 'false'">
            <a class="pideco-product-image" t-att-href="product.website_url">
                <div class="pideco-product-badges"><span t-if="product.compare_list_price and product.compare_list_price &gt; product.list_price">Offer</span><span t-elif="product.create_date">New</span></div>
                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
            </a>
            <h3><a t-att-href="product.website_url" t-out="product.name"/></h3>
            <strong t-out="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
            <button type="button" class="btn btn-primary pideco-card-add" t-if="product._website_show_quick_add()">Add to cart</button>
        </article>
    </template>
</odoo>
